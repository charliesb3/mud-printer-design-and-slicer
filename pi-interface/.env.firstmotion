# First physical motion test — Pi configuration.
#
# Copy this file to .env on the Pi before the first jog test.
#   - 76 mm/min (≈ 0.05 in/s) default jog speed at startup
#     (slow — the operator picks a higher preset in the UI once comfortable).
#   - 3048 mm/min (= 2.0 in/s) ceiling: the maximum selectable speed in the UI.
#   - Hardware backend `gpio` (REMOTE STOP + manual Z active via GPIO)
#   - Z_PWM_DUTY=0 until MD13S default-STOP check passes
#     (docs/acceptance-test.md step 1).
#
# IMPORTANT: GRBL must independently permit 2.0 in/s. The Pi can only ASK
# GRBL to jog at a given feed; GRBL silently clamps it to the smaller of the
# requested feed and `$110` / `$111`. Before raising the UI ceiling above
# the current GRBL limit, raise $110 / $111 on the Arduino:
#
#     $110=3048     (X max rate, mm/min — 2.0 in/s)
#     $111=3048     (Y max rate, mm/min — 2.0 in/s)
#
# Send these from the controller UI's console only after you have CAPTURED
# the current settings via Advanced / Diagnostics / Settings ($$) and
# saved them to `arduino-grbl/captures/`. Keep acceleration ($120 / $121)
# as it is: raising feed rate alone is safe for a drivetrain that already
# accelerates well below its limit; raising acceleration is a separate
# experiment and must be done progressively.
#
# Before using: confirm the physical E-STOP is functional and within reach;
# confirm GRBL $100 / $101 (steps/mm) have been written and verified on the
# Arduino (`arduino-grbl/steps-per-mm-calculation.md`); and complete the
# GRBL capture checklist (`docs/grbl-capture-checklist.md`).

# Stable serial device from the udev rule (deploy/99-mudpr-grbl.rules.example).
SERIAL_PORT=/dev/mudpr-grbl
BAUD_RATE=115200

# Low startup default so the UI opens at a conservative speed; operator
# raises to 2.0 in/s with the preset buttons.
JOG_SPEED_MM_MIN=76
JOG_SPEED_MAX_MM_MIN=3048

JOG_SEND_INTERVAL_S=0.15
JOG_TIMEOUT_S=0.3

STATUS_POLL_INTERVAL_S=0.2
GRBL_UNRESPONSIVE_S=5.0

JOBS_DIR=jobs
HOST=0.0.0.0
PORT=8000

# Hardware: engage GPIO on the Pi (REMOTE STOP, remote inputs, Z outputs).
HARDWARE_BACKEND=gpio
REMOTE_POLL_INTERVAL_S=0.01
REMOTE_DEBOUNCE_S=0.05

# Z actuator FIRST MOTION — Cytron MD13S + 12 V linear actuator.
#
# Z_PWM_DUTY sets the FIXED PWM duty used for every manual Z move: it is
# applied only while a touchscreen or remote Z button is held (dead-man),
# and PWM returns to 0 the instant the button is released, on heartbeat
# timeout, on REMOTE STOP, on job stop, on connection loss, and on service
# shutdown. The Pi's config.txt also drives the PWM pin LOW at boot
# (`gpio=18=op,dl`), so a Pi crash / power loss leaves PWM LOW too.
#
# 0.50 (50 %) is a conservative first-motion value: enough torque to lift
# the Z nozzle assembly under its own weight; well below full driver output.
# Raise or lower this ONE line after the first operator test and keep notes.
#
# PRE-FIRST-MOTION HARDWARE CHECK (not satisfied by software — still open):
#   An external pull-down resistor on the MD13S PWM input is REQUIRED to
#   guarantee PWM = LOW during Pi power-up and cold boot (see
#   `docs/deployment.md` §7). The value is proposed as 10 kΩ but must be
#   measured on the installed board. The actuator must be mechanically
#   clear of travel ends and the operator must be at the touchscreen with
#   the physical E-STOP within reach before the first press.
Z_PWM_DUTY=0.5
Z_PWM_FREQUENCY_HZ=1000
# true if Z UP drives the actuator DOWN — found by direction test on first
# press. Flip this value, redeploy, test again.
Z_DIR_INVERT=false
# Dead-man: Z stops if a held button is not refreshed within this interval.
Z_TIMEOUT_S=0.3
# Any single continuous Z run stops after this many seconds. 30 s @ 50 %
# duty is comfortably longer than the 18 in stroke of the actuator at
# typical open-loop speeds — adjust after first test.
Z_MAX_RUN_S=30

# Single-shot jog distance (inches) — see JOG_SINGLE_DISTANCE_IN comment in
# .env.example. 10 in at 2 in/s = 5 s per press; the operator releases and
# re-presses to continue beyond this. Deliberately NOT the machine envelope.
JOG_SINGLE_DISTANCE_IN=10.0
