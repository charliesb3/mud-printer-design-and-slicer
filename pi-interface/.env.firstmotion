# First physical motion test — conservative Pi configuration.
#
# Copy this file to .env on the Raspberry Pi before the first jog test, then
# edit SERIAL_PORT if needed. These values are deliberately conservative:
#
#   - 300 mm/min default jog speed (≈ 0.197 in/s)
#   - 900 mm/min ceiling (≈ 0.591 in/s)
#   - Nominal envelope reported as the 120 × 120 in design value,
#     EXPLICITLY NOT verified — the UI shows the "not verified" warning
#     and no travel limits are enforced by this software.
#
# Before using: confirm the physical E-STOP is functional and within reach,
# confirm GRBL $100 / $101 (steps/mm) have been written and verified on the
# Arduino, and complete the GRBL capture checklist (docs/grbl-capture-checklist.md).

# Serial port — adjust to whatever the Arduino presents on the Pi (usually ttyUSB0 or ttyACM0).
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=115200

# Conservative first-motion jog speed. Default well below ceiling so the
# operator cannot accidentally send the machine at full ceiling right away.
JOG_SPEED_MM_MIN=300
JOG_SPEED_MAX_MM_MIN=900

JOG_SEND_INTERVAL_S=0.15
JOG_TIMEOUT_S=0.3

# Nominal design envelope. NOT verified physical travel limits.
# UI will still display the "nominal, not verified" warning.
PRINTER_ENVELOPE_X_IN=120
PRINTER_ENVELOPE_Y_IN=120
PRINTER_EXTENTS_VERIFIED=0

STATUS_POLL_INTERVAL_S=0.2
JOBS_DIR=jobs
HOST=0.0.0.0
PORT=8000
