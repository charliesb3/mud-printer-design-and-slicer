# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Environment
.env

# Local deployment config: historically at pi-interface/scripts/deploy.config.
# From 2026-10-25 the authoritative location is the REPO ROOT (/deploy.config),
# ignored by the root .gitignore. This entry stays only to catch an old copy
# left behind on a developer machine.
scripts/deploy.config

# Job storage (runtime data, not committed)
/jobs/

# OS
.DS_Store

# Editor
.vscode/
.idea/

# this controller's machine profile (local configuration, not source)
machine_profile.json

# operator-adjusted Z PWM duty, persisted at runtime (operator setting, not source)
z_setting.json
