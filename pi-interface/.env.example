# Copy this file to .env and edit for your environment.
# .env is gitignored — never commit it.

# Serial port to the Arduino/GRBL controller.
# Mac development (no Arduino): leave as-is; app will show Disconnected.
# Mac with Arduino connected: typically /dev/cu.usbmodem* or /dev/cu.usbserial*
# Raspberry Pi: typically /dev/ttyUSB0 or /dev/ttyACM0
SERIAL_PORT=/dev/ttyUSB0

# GRBL baud rate — 115200 is the GRBL default.
BAUD_RATE=115200

# ---------------------------------------------------------------------------
# Jog configuration
# ---------------------------------------------------------------------------
#
# JOG_SPEED_MM_MIN     — default jog speed at startup, in mm/min.
# JOG_SPEED_MAX_MM_MIN — hard ceiling that the UI slider cannot exceed, in mm/min.
#
# IMPORTANT: These values have NOT been validated on the physical machine.
# Do not set them high until safe jogging has been confirmed at a
# conservative speed on the actual printer. Leave JOG_SPEED_MM_MIN at 0 to
# disable jogging entirely. The UI shows jog speed in in/s; GRBL always
# receives mm/min.
#
#   300 mm/min ≈ 0.197 in/s   (conservative first-motion value)
#   900 mm/min ≈ 0.591 in/s   (reasonable ceiling for the first jog session)
#  3048 mm/min ≈ 2.000 in/s   (desirable future target — DO NOT ENABLE YET)
#  9144 mm/min ≈ 6.000 in/s   (aspirational future target — DO NOT ENABLE YET)
#
JOG_SPEED_MM_MIN=0
JOG_SPEED_MAX_MM_MIN=0

# How often the backend sends an incremental jog command (seconds).
# Each step covers: current_jog_speed_mm_min * JOG_SEND_INTERVAL_S / 60 mm.
# Maximum motion after connection loss = approximately 1-2 step distances.
JOG_SEND_INTERVAL_S=0.15

# Heartbeat timeout: if no jog_heartbeat from browser within this time, stop jogging.
JOG_TIMEOUT_S=0.3

# ---------------------------------------------------------------------------
# Printer envelope (nominal, display-only)
# ---------------------------------------------------------------------------
#
# Nominal usable travel of the XY frame, in inches. Shown in the UI for
# operator reference. These are NOT verified physical travel limits and the
# Pi interface does NOT enforce them — GRBL firmware limits (if any) remain
# the only enforced bound. Leave at 0 to display "Unconfigured printer"
# until the operator confirms the usable area. Set PRINTER_EXTENTS_VERIFIED=1
# only after physically confirming usable travel.
#
PRINTER_ENVELOPE_X_IN=0
PRINTER_ENVELOPE_Y_IN=0
PRINTER_EXTENTS_VERIFIED=0

# GRBL status poll interval (seconds). 0.2 = 5 Hz.
STATUS_POLL_INTERVAL_S=0.2

# Directory for job file storage (relative to pi-interface/).
JOBS_DIR=jobs

# Web server host and port.
HOST=0.0.0.0
PORT=8000
