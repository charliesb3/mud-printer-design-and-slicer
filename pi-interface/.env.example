# Copy this file to .env and edit for your environment.
# .env is gitignored — never commit it.

# Serial port to the Arduino/GRBL controller.
# Mac development (no Arduino): leave as-is; app will show Disconnected.
# Mac with Arduino connected: typically /dev/cu.usbmodem* or /dev/cu.usbserial*
# Raspberry Pi: the stable udev name /dev/mudpr-grbl (docs/deployment.md →
# "Stable serial device"); before the rule exists: /dev/ttyACM0 (genuine Uno)
# or /dev/ttyUSB0 (CH340 clone).
SERIAL_PORT=/dev/ttyUSB0

# GRBL baud rate — 115200 is the GRBL default.
BAUD_RATE=115200

# Jog speed, mm/min.
#
# JOG_SPEED_MM_MIN     — default jog speed at startup.
# JOG_SPEED_MAX_MM_MIN — hard ceiling the UI preset buttons cannot exceed.
#
# The UI shows jog speed in in/s and GRBL always receives mm/min. 0 disables
# jogging. The UI's preset buttons are 0.05 / 0.1 / 0.25 / 0.5 / 1.0 / 2.0
# in/s; a preset above the ceiling is disabled.
#
# IMPORTANT: GRBL's own `$110` / `$111` must independently permit the ceiling,
# or GRBL will silently clamp the feed to its own limit. See the first-motion
# template `.env.firstmotion` for the console commands.
#
#   300 mm/min ≈ 0.197 in/s   (conservative first-motion value)
#   900 mm/min ≈ 0.591 in/s   (slow ceiling for the first jog session)
#  3048 mm/min = 2.000 in/s   (product target — the UI's Max preset)
#  9144 mm/min = 6.000 in/s   (aspirational — DO NOT ENABLE WITHOUT TESTING)
#
# See `arduino-grbl/steps-per-mm-calculation.md` for the drivetrain-safe
# derivation and the microstep setting that must be physically verified.
JOG_SPEED_MM_MIN=0
JOG_SPEED_MAX_MM_MIN=0

# Single-shot jog model (2026-10-25). On jog_start the server sends ONE
# $J=G21 G91 <axis><distance> F<speed> line with distance =
# JOG_SINGLE_DISTANCE_IN inches. GRBL executes that single move and stops
# naturally at its end. The server never sends another $J= during a hold.
# On release / heartbeat timeout / cancel, the server writes GRBL's 0x85
# jog-cancel real-time byte, which decelerates the single in-flight jog at
# $120 / $121.
#
# JOG_SEND_INTERVAL_S is now ONLY the heartbeat-poll / stop-flag poll
# interval inside the single-shot session, NOT a command-send interval.
# A smaller value gives faster cancel on heartbeat timeout; it does not
# affect normal release latency (release triggers cancel immediately).
JOG_SEND_INTERVAL_S=0.05

# Heartbeat timeout: if no jog_heartbeat from browser within this time, stop jogging.
JOG_TIMEOUT_S=0.3

# Distance (inches) GRBL moves per single press-and-hold. The operator
# releases and re-presses to continue beyond this. Keep well below the
# machine envelope (nominal 120 in) — this is not a travel limit.
JOG_SINGLE_DISTANCE_IN=10.0

# GRBL status poll interval (seconds). 0.2 = 5 Hz.
STATUS_POLL_INTERVAL_S=0.2

# While a job runs, a line may wait for GRBL's ok as long as GRBL keeps
# answering status polls (full planner buffer / feed hold can take minutes).
# The job fails only after this many seconds WITHOUT any status report.
GRBL_UNRESPONSIVE_S=5.0

# Directory for job file storage (relative to pi-interface/).
JOBS_DIR=jobs

# Web server host and port.
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------
# Raspberry Pi hardware (pin numbers live in app/hardware/pins.py ONLY)
# ------------------------------------------------------------------

# none = no GPIO (Mac development) | mock = simulated pins | gpio = the Pi.
HARDWARE_BACKEND=none

# Remote inputs: sample interval and debounce (seconds).
REMOTE_POLL_INTERVAL_S=0.01
REMOTE_DEBOUNCE_S=0.05

# Manual Z (Cytron MD13S). FIXED PWM duty 0–1 used for every manual Z move.
# 0 = manual Z DISABLED. Leave 0 until the MD13S default-STOP check and the
# actuator test of docs/acceptance-test.md have passed. 0.5 is a reasonable
# first non-zero value for a 12 V linear actuator; raise or lower based on
# physical behaviour. See .env.firstmotion for the full commentary.
Z_PWM_DUTY=0
Z_PWM_FREQUENCY_HZ=1000
# true if Z UP drives the actuator down (found at the actuator test).
Z_DIR_INVERT=false
# Dead-man: Z stops if a held button is not refreshed within this time.
Z_TIMEOUT_S=0.3
# Any single continuous Z run stops after this many seconds.
Z_MAX_RUN_S=30
